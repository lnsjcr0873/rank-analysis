{
  "name": "rank-analysis",
  "private": true,
  "description": "rank analysis app",
  "type": "module",
  "author": "wnzzer",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit --composite false",
    "check": "npm run format && npm run lint && npm run typecheck && npm run check:rust",
    "check:rust": "cd src-tauri && cargo fmt --all -- --check && cargo clippy --all-targets --all-features -- -Dwarnings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "markdown-it": "^15.0.0",
    "naive-ui": "^2.45.0",
    "pinia": "^4.0.3",
    "vue": "^3.4.15",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22",
    "@vicons/ionicons5": "^0.12.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10",
    "eslint-plugin-vue": "^10",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "terser": "^5.39.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.8"
  }
}
