                            .selected_perk_ids
                            .iter()
                            .take(3)
                            .map(|perk| PerkSelection {
                                perk: *perk,
                                ..Default::default()
                            })
                            .collect(),
                    },
                    PerkStyle {
                        description: None,
                        style: b.sub_style_id,
                        selections: b
                            .selected_perk_ids
                            .iter()
                            .skip(3)
                            .take(2)
                            .map(|perk| PerkSelection {
                                perk: *perk,
                                ..Default::default()
