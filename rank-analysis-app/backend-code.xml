                    flex: b.flex,
                    offense: b.offense,
                }),
            }),
            ..Default::default()
        }
    }

    fn game(
        game_id: i64,
        my_puuid: &str,
        champ: i32,
        build: Option<&RunePageBuild>,
        spells: (i32, i32),
    ) -> Game {
        Game {
            game_id,
            game_detail: GameDetail {
                participants: vec![participant(1, champ, build, spells)],
                participant_identities: vec![identity(my_puuid)],
                ..Default::default()
            },
            ..Default::default()
        }
    }

    fn build(primary: i32, sub: i32, ids: &[i32]) -> RunePageBuild {
        RunePageBuild {
            primary_style_id: primary,
            sub_style_id: sub,
            selected_perk_ids: ids.to_vec(),
            defense: 5001,
            flex: 5008,
            offense: 5008,
        }
    }

    #[test]
    fn picks_most_common_full_page() {
        let a = build(8100, 8300, &[8112, 8122, 8135, 8139, 8304]);
        let b = build(8200, 8400, &[8212, 8222, 8235, 8239, 8404]);
        let games = vec![
            game(1, "p", 64, Some(&a), (4, 14)),
            game(2, "p", 64, Some(&a), (4, 14)),
            game(3, "p", 64, Some(&b), (4, 14)),
            game(4, "p", 64, Some(&a), (4, 14)),
        ];
        assert_eq!(
            most_common_perk_page(&games, "p", 64, AGGREGATE_LIMIT).unwrap(),
            a
        );
