        let yaml = serde_yaml::to_string(&value).unwrap();
        let deserialized: Value = serde_yaml::from_str(&yaml).unwrap();
        assert_eq!(value, deserialized);

        let value = Value::Integer(42);
        let yaml = serde_yaml::to_string(&value).unwrap();
        let deserialized: Value = serde_yaml::from_str(&yaml).unwrap();
        assert_eq!(value, deserialized);

        let value = Value::Boolean(true);
        let yaml = serde_yaml::to_string(&value).unwrap();
        let deserialized: Value = serde_yaml::from_str(&yaml).unwrap();
