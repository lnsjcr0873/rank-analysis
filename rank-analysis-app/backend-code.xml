        let d = evaluate_bp_decision(&ctx(&s, &rules, &[], None)).unwrap();
        let t = d.target.unwrap();
        assert_eq!(t.champion_id, 64);
        assert_eq!(
            t.origin,
            BpOrigin::Rule {
                rule_id: "r2".into(),
                rule_name: "打野保底".into(),
